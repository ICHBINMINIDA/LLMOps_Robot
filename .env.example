# ---- Where Ollama lives -------------------------------------------------
# Deep server reachable directly (VPN / university network):
OLLAMA_API_BASE=http://deep-server.example.de:11434
# Or through an SSH tunnel on your laptop (ssh -N -L 11434:localhost:11434 user@deep-server):
# OLLAMA_API_BASE=http://host.docker.internal:11434
# Or a local Ollama later, when you lose server access: same value as the tunnel line.

# ---- LiteLLM gateway ----------------------------------------------------
LITELLM_MASTER_KEY=sk-robot-llmops-change-me
# Gateway URL used by the bench scripts (host port from docker-compose.yml)
LITELLM_URL=http://localhost:4002

# ---- GPU monitoring via SSH + nvidia-smi --------------------------------
# GPU_MODE=ssh  -> runs nvidia-smi on SSH_TARGET (deep server)
# GPU_MODE=local -> runs nvidia-smi on the machine running the exporter
# GPU_MODE=off  -> only Ollama /api/ps metrics (VRAM per loaded model)
GPU_MODE=ssh
SSH_TARGET=user@deep-server.example.de
SCRAPE_INTERVAL_SECONDS=5

# ---- Grafana -------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=admin
